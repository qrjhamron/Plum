{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlumCraft Launcher",
  "version": "1.0.0",
  "identifier": "id.plumcraft.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PlumCraft Launcher",
        "width": 1120,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4173; img-src 'self' https://minotar.net data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "Minecraft: Java Edition launcher dengan PlumClient",
    "resources": {
      "resources/engine": "engine"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
